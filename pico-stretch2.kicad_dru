(version 1)
(rule "Tight placement as built (named pairs)"
    (condition "(A.Reference == 'U1' && B.Reference == 'C1') || (A.Reference == 'C1' && B.Reference == 'U1') || (A.Reference == 'U1' && B.Reference == 'C3') || (A.Reference == 'C3' && B.Reference == 'U1') || (A.Reference == 'U1' && B.Reference == 'C5') || (A.Reference == 'C5' && B.Reference == 'U1') || (A.Reference == 'U1' && B.Reference == 'C8') || (A.Reference == 'C8' && B.Reference == 'U1') || (A.Reference == 'U1' && B.Reference == 'C11') || (A.Reference == 'C11' && B.Reference == 'U1') || (A.Reference == 'U1' && B.Reference == 'C13') || (A.Reference == 'C13' && B.Reference == 'U1') || (A.Reference == 'U1' && B.Reference == 'C22') || (A.Reference == 'C22' && B.Reference == 'U1') || (A.Reference == 'U1' && B.Reference == 'C36') || (A.Reference == 'C36' && B.Reference == 'U1') || (A.Reference == 'L1' && B.Reference == 'C10') || (A.Reference == 'C10' && B.Reference == 'L1') || (A.Reference == 'L1' && B.Reference == 'C16') || (A.Reference == 'C16' && B.Reference == 'L1') || (A.Reference == 'USB1' && B.Reference == 'D1') || (A.Reference == 'D1' && B.Reference == 'USB1') || (A.Reference == 'USB1' && B.Reference == 'R4') || (A.Reference == 'R4' && B.Reference == 'USB1') || (A.Reference == 'D2' && B.Reference == 'R1') || (A.Reference == 'R1' && B.Reference == 'D2') || (A.Reference == 'Boot1' && B.Reference == 'R5') || (A.Reference == 'R5' && B.Reference == 'Boot1') || (A.Reference == 'C40' && B.Reference == 'C38') || (A.Reference == 'C38' && B.Reference == 'C40') || (A.Reference == 'C40' && B.Reference == 'U3') || (A.Reference == 'U3' && B.Reference == 'C40') || (A.Reference == 'D3' && B.Reference == 'C37') || (A.Reference == 'C37' && B.Reference == 'D3') || (A.Reference == 'C39' && B.Reference == 'C37') || (A.Reference == 'C37' && B.Reference == 'C39') || (A.Reference == 'D3' && B.Reference == 'R3') || (A.Reference == 'R3' && B.Reference == 'D3') || (A.Reference == 'D3' && B.Reference == 'R4') || (A.Reference == 'R4' && B.Reference == 'D3') || (A.Reference == 'D3' && B.Reference == 'C39') || (A.Reference == 'C39' && B.Reference == 'D3') || (A.Reference == 'C39' && B.Reference == 'R4') || (A.Reference == 'R4' && B.Reference == 'C39')")
    (constraint courtyard_clearance (min 0mm))
    (severity ignore)
)
